{
  "name": "sgp-sdd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "verify": "node scripts/verify/verify.ts",
    "sonar:up": "node scripts/sonar/up.ts",
    "sonar:setup": "node scripts/sonar/setup.ts",
    "sonar": "node scripts/sonar/analyze.ts",
    "metrics:ia": "node scripts/metrics/record-ia.ts",
    "metrics:check": "node scripts/metrics/check-ia.ts",
    "metrics:consolidar": "node scripts/metrics/consolidate.ts"
  },
  "devDependencies": {
    "@sonar/scan": "5.0.2",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
